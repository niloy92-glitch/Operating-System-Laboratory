pages=[7,0,1,2,0,3,0,4,2,3]
frames = 4

memory=[]
page_hit = 0
page_miss = 0
recent_page = 0

for page in pages:
  if page in memory:
    page_hit +=1
    recent_page = page
    print(page, "Page Hit", memory)
  else:
    if len(memory) < frames:
      memory.append(page)
    else:
      memory[memory.index(recent_page)] = page
      recent_page = page
    page_miss +=1

print(page, "Page Miss", memory)

print("Page Hit: ", page_hit)
print("Page Miss: ", page_miss)
