

    current_time = current_time + bt
    ct = current_time

    tat = ct - at
    wt = tat - bt

    completed.append([pid, at, bt, priority, ct, tat, wt])
    processes.remove(selected)



print("\n")
print("PID\tAT\tBT\tPriority\tCT\tTAT\tWT")
print("-")

total_tat = 0
total_wt = 0

